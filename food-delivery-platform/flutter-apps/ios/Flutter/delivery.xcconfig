// Flavor: delivery — select by duplicating the Runner scheme as "delivery" and pointing
// its Debug/Release/Profile configurations at Debug-delivery / Release-delivery / Profile-delivery
// (see docs/FLUTTER_BUILD_GUIDE.md → iOS flavors).
APP_FLAVOR=delivery
APP_DISPLAY_NAME=$(DELIVERY_APP_NAME:default=Delivery)
PRODUCT_BUNDLE_IDENTIFIER=$(APP_ID_BASE:default=com.fooddelivery).delivery
GOOGLE_MAPS_KEY=$(GOOGLE_MAPS_KEY)
FLUTTER_TARGET=lib/main_delivery.dart
