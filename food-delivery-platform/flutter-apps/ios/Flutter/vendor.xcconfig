// Flavor: vendor — select by duplicating the Runner scheme as "vendor" and pointing
// its Debug/Release/Profile configurations at Debug-vendor / Release-vendor / Profile-vendor
// (see docs/FLUTTER_BUILD_GUIDE.md → iOS flavors).
APP_FLAVOR=vendor
APP_DISPLAY_NAME=$(VENDOR_APP_NAME:default=Vendor)
PRODUCT_BUNDLE_IDENTIFIER=$(APP_ID_BASE:default=com.fooddelivery).vendor
GOOGLE_MAPS_KEY=$(GOOGLE_MAPS_KEY)
FLUTTER_TARGET=lib/main_vendor.dart
