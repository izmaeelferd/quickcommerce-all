# docker-compose variables (backend secrets live in backend/.env)
# Public URL of the API as seen by browsers (baked into the admin/vendor web builds)
PUBLIC_API_URL=http://localhost:5000
# Ports are bound to 127.0.0.1 so only the nginx reverse proxy is exposed publicly.
# Set BIND_HOST=0.0.0.0 to reach the containers directly (e.g. local testing on a LAN).
BIND_HOST=127.0.0.1
API_PORT=5000
ADMIN_PORT=5173
VENDOR_PORT=5174
