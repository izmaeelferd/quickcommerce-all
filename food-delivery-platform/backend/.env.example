# ---------- Server ----------
NODE_ENV=development
PORT=5000
API_PREFIX=/api
PUBLIC_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- Database ----------
MONGO_URI=mongodb://localhost:27017/food_delivery

# ---------- Auth ----------
JWT_SECRET=change_me_access_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
OTP_EXPIRY_MINUTES=10
BCRYPT_ROUNDS=10

# ---------- Social sign-in ----------
GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com
APPLE_CLIENT_ID=com.example.fooddelivery

# ---------- Payments (PAYMENT_PROVIDER=razorpay | stripe) ----------
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Email (Nodemailer) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com

# ---------- SMS (Twilio) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Push (FCM) ----------
# Either a path to the service account JSON or the JSON itself (base64)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---------- Uploads (UPLOAD_DRIVER=local | s3) ----------
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=30

# ---------- Seeder ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123
