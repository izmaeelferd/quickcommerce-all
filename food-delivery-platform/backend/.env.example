# =====================================================================
# Backend environment. Copy to backend/.env and fill in. Every value the
# server reads is listed here. See docs/ENVIRONMENT_SETUP.md for where to
# obtain each key. In NODE_ENV=production the server refuses to start with
# weak/missing secrets, CLIENT_URLS="*" or a missing PUBLIC_BASE_URL.
# Quote any value that contains "#" or spaces, e.g. ADMIN_DEFAULT_PASSWORD="S3cure#Pass" —
# unquoted, everything after "#" is treated as a comment.
# =====================================================================

# ---------- Server ----------
NODE_ENV=development
PORT=5000
API_PREFIX=/api
# Public origin of this API (used to build uploaded-file URLs), e.g. https://api.example.com
PUBLIC_BASE_URL=http://localhost:5000
# Comma-separated browser origins allowed by CORS (admin panel, vendor dashboard). Never "*" in production.
CLIENT_URLS=http://localhost:5173,http://localhost:5174

# ---------- Database ----------
MONGODB_URI=mongodb://localhost:27017/food_delivery

# ---------- Auth (generate with: openssl rand -hex 48) ----------
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30

# ---------- First admin (created by the seeder) ----------
ADMIN_DEFAULT_EMAIL=admin@yourapp.com
# REQUIRED in production. CHANGE THE PASSWORD IMMEDIATELY after first login.
# Left empty in development → the seeder generates one and prints it once.
ADMIN_DEFAULT_PASSWORD=

# ---------- Social sign-in ----------
# Comma-separated OAuth client IDs (Android, iOS, Web) from Google Cloud Console
GOOGLE_CLIENT_IDS=
# iOS bundle id (or Services ID) used for Sign in with Apple
APPLE_CLIENT_ID=

# ---------- Payments: PAYMENT_PROVIDER=razorpay | stripe ----------
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → secret (different from the key secret)
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Email (Nodemailer / SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---------- SMS / OTP (Twilio) ----------
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=

# ---------- Push (Firebase Cloud Messaging, HTTP v1) ----------
# Service-account JSON (Firebase console → Project settings → Service accounts).
# Provide a path OR the base64 of the file. The legacy FCM_SERVER_KEY is not
# supported: Google shut the legacy FCM API down in 2024.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---------- File uploads: UPLOAD_DRIVER=local | s3 ----------
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Optional (UPLOAD_DRIVER=s3). Any S3-compatible store works (AWS, R2, Spaces, MinIO).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=30

# ---------- Demo data (seeder) ----------
# Password for the demo vendor/customer/rider accounts (development only;
# demo data is skipped in production unless you pass --demo).
SEED_SAMPLE_PASSWORD=Password@123
# Centre point for demo restaurants
SEED_LAT=12.9716
SEED_LNG=77.5946
