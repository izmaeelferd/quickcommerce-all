# ---- build ----
FROM node:20-alpine AS build
WORKDIR /app
COPY admin-panel/package*.json ./
RUN npm ci
COPY admin-panel/ ./
# The API location is the only build-time setting; everything else comes from /api/config at runtime.
ARG VITE_API_URL=
ARG VITE_API_PREFIX=/api
ENV VITE_API_URL=$VITE_API_URL VITE_API_PREFIX=$VITE_API_PREFIX
RUN npm run build

# ---- serve ----
FROM nginx:1.27-alpine
COPY admin-panel/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
