{
  "$description": "QuickCart design tokens (blueprint). W3C Design Tokens Community Group format, Style Dictionary v4 compatible. Brand-neutral placeholder palette: every brand value is replaced per tenant at build or runtime. Semantic colors and shadows carry the light value in $value and the dark value in $extensions['com.quickcart.modes'].dark. Tiers: primitive -> semantic (color, typography, space, radius, shadow, motion, zIndex, breakpoint, size, opacity) -> component.",
  "$extensions": {
    "com.quickcart.meta": {
      "version": "1.0.0-blueprint",
      "status": "blueprint",
      "modes": ["light", "dark"],
      "tenantOverridable": [
        "primitive.color.brand",
        "primitive.color.brandSecondary",
        "primitive.color.brandAccent",
        "primitive.font.family.brand",
        "radius.scaleFactor"
      ]
    }
  },

  "primitive": {
    "$description": "Tier 1: reference values. Never used directly by components.",
    "color": {
      "$type": "color",
      "neutral": {
        "0":    { "$value": "#FFFFFF" },
        "50":   { "$value": "#F5F6F7" },
        "100":  { "$value": "#ECEEF0" },
        "200":  { "$value": "#DADDE1" },
        "300":  { "$value": "#C2C7CD" },
        "400":  { "$value": "#9AA1A9" },
        "500":  { "$value": "#737B84" },
        "600":  { "$value": "#59616A" },
        "700":  { "$value": "#434A52" },
        "800":  { "$value": "#2C3238" },
        "900":  { "$value": "#1C2025" },
        "950":  { "$value": "#121518" },
        "1000": { "$value": "#0B0D0F" }
      },
      "brand": {
        "$description": "Placeholder tenant primary (neutral teal-blue). Regenerated from tenant brand.primary.",
        "50":  { "$value": "#E8F4F8" },
        "100": { "$value": "#C9E5EE" },
        "200": { "$value": "#97CBDD" },
        "300": { "$value": "#5FAECB" },
        "400": { "$value": "#2F92B5" },
        "500": { "$value": "#12789C" },
        "600": { "$value": "#0B6283" },
        "700": { "$value": "#0A4F6A" },
        "800": { "$value": "#093D52" },
        "900": { "$value": "#072C3B" },
        "950": { "$value": "#041C26" }
      },
      "brandSecondary": {
        "$description": "Placeholder tenant secondary (slate indigo). Regenerated from tenant brand.secondary.",
        "50":  { "$value": "#EEF0F8" },
        "100": { "$value": "#D6DBEE" },
        "200": { "$value": "#AEB8DC" },
        "300": { "$value": "#8592C6" },
        "400": { "$value": "#6371AF" },
        "500": { "$value": "#4A5794" },
        "600": { "$value": "#3A4578" },
        "700": { "$value": "#2D365E" },
        "800": { "$value": "#212845" },
        "900": { "$value": "#161B2F" }
      },
      "brandAccent": {
        "$description": "Placeholder tenant accent (muted coral). Regenerated from tenant brand.accent.",
        "50":  { "$value": "#FEF0EB" },
        "100": { "$value": "#FCD9CC" },
        "200": { "$value": "#F8B39A" },
        "300": { "$value": "#F28A66" },
        "400": { "$value": "#E8693F" },
        "500": { "$value": "#CC5126" },
        "600": { "$value": "#A6401D" },
        "700": { "$value": "#813217" },
        "800": { "$value": "#5E2411" },
        "900": { "$value": "#40190C" }
      },
      "green": {
        "50":  { "$value": "#E9F7EE" },
        "100": { "$value": "#C9EDD6" },
        "200": { "$value": "#95DAAE" },
        "300": { "$value": "#5CC283" },
        "400": { "$value": "#2FA75F" },
        "500": { "$value": "#1A8C4A" },
        "600": { "$value": "#12733C" },
        "700": { "$value": "#0F5C31" },
        "800": { "$value": "#0C4626" },
        "900": { "$value": "#08321B" }
      },
      "red": {
        "50":  { "$value": "#FDECEC" },
        "100": { "$value": "#FAD1D1" },
        "200": { "$value": "#F4A3A3" },
        "300": { "$value": "#EC7272" },
        "400": { "$value": "#E14848" },
        "500": { "$value": "#C92A2A" },
        "600": { "$value": "#A82020" },
        "700": { "$value": "#861A1A" },
        "800": { "$value": "#651414" },
        "900": { "$value": "#470E0E" }
      },
      "amber": {
        "50":  { "$value": "#FFF7E6" },
        "100": { "$value": "#FEEBC0" },
        "200": { "$value": "#FCD788" },
        "300": { "$value": "#F8BD4A" },
        "400": { "$value": "#F0A01F" },
        "500": { "$value": "#D4840B" },
        "600": { "$value": "#A96706" },
        "700": { "$value": "#7F4D06" },
        "800": { "$value": "#5C3806" },
        "900": { "$value": "#3F2705" }
      },
      "blue": {
        "50":  { "$value": "#EAF2FE" },
        "100": { "$value": "#CFE0FC" },
        "200": { "$value": "#A0C2F8" },
        "300": { "$value": "#6CA0F2" },
        "400": { "$value": "#3F7FE8" },
        "500": { "$value": "#2563D4" },
        "600": { "$value": "#1B4DAE" },
        "700": { "$value": "#173D88" },
        "800": { "$value": "#132E66" },
        "900": { "$value": "#0E2149" }
      },
      "violet": {
        "50":  { "$value": "#F3EEFD" },
        "100": { "$value": "#E3D7FA" },
        "200": { "$value": "#C7AFF4" },
        "300": { "$value": "#A784EC" },
        "400": { "$value": "#8A5DE1" },
        "500": { "$value": "#7040CC" },
        "600": { "$value": "#5A31A8" },
        "700": { "$value": "#472783" },
        "800": { "$value": "#351D61" },
        "900": { "$value": "#251444" }
      },
      "alpha": {
        "scrimLight":   { "$value": "#0B0D0F8F", "$description": "neutral.1000 at 56%" },
        "scrimDark":    { "$value": "#000000A3", "$description": "black at 64%" },
        "pressLight":   { "$value": "#1C202514", "$description": "neutral.900 at 8%" },
        "pressDark":    { "$value": "#F5F6F71F", "$description": "neutral.50 at 12%" },
        "shadowLight":  { "$value": "#0B0D0F1F", "$description": "neutral.1000 at 12%" },
        "shadowLightStrong": { "$value": "#0B0D0F33", "$description": "neutral.1000 at 20%" },
        "shadowDark":   { "$value": "#00000066", "$description": "black at 40%" },
        "shadowDarkStrong": { "$value": "#00000099", "$description": "black at 60%" }
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "brand":      { "$value": ["Inter", "Noto Sans", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"], "$description": "Tenant-overridable Latin family. Fallbacks always appended." },
        "latin":      { "$value": ["Inter", "Noto Sans", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
        "arabic":     { "$value": ["Noto Sans Arabic", "Noto Naskh Arabic", "Segoe UI", "Tahoma", "sans-serif"] },
        "devanagari": { "$value": ["Noto Sans Devanagari", "Mukta", "Nirmala UI", "sans-serif"] },
        "mono":       { "$value": ["JetBrains Mono", "Roboto Mono", "ui-monospace", "Menlo", "Consolas", "monospace"] }
      },
      "weight": {
        "$type": "fontWeight",
        "regular":  { "$value": 400 },
        "medium":   { "$value": 500 },
        "semibold": { "$value": 600 },
        "bold":     { "$value": 700 }
      },
      "size": {
        "$type": "dimension",
        "11": { "$value": "11px" },
        "12": { "$value": "12px" },
        "13": { "$value": "13px" },
        "14": { "$value": "14px" },
        "16": { "$value": "16px" },
        "18": { "$value": "18px" },
        "20": { "$value": "20px" },
        "24": { "$value": "24px" },
        "28": { "$value": "28px" },
        "32": { "$value": "32px" },
        "40": { "$value": "40px" }
      }
    },
    "duration": {
      "$type": "duration",
      "0":   { "$value": "0ms" },
      "50":  { "$value": "50ms" },
      "100": { "$value": "100ms" },
      "150": { "$value": "150ms" },
      "200": { "$value": "200ms" },
      "250": { "$value": "250ms" },
      "300": { "$value": "300ms" },
      "400": { "$value": "400ms" },
      "500": { "$value": "500ms" },
      "1200": { "$value": "1200ms" },
      "1500": { "$value": "1500ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "linear":     { "$value": [0, 0, 1, 1] },
      "standard":   { "$value": [0.2, 0, 0, 1] },
      "decelerate": { "$value": [0, 0, 0, 1] },
      "accelerate": { "$value": [0.3, 0, 1, 1] },
      "emphasized": { "$value": [0.2, 0, 0, 1.2] }
    }
  },

  "color": {
    "$type": "color",
    "$description": "Tier 2: semantic roles. $value = light mode; dark mode under $extensions.com.quickcart.modes.dark.",
    "background": {
      "canvas": { "$value": "{primitive.color.neutral.50}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.1000}" } } }
    },
    "surface": {
      "base":    { "$value": "{primitive.color.neutral.0}",   "$description": "Cards, lists, app bar", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.950}" } } },
      "raised":  { "$value": "{primitive.color.neutral.0}",   "$description": "Elevated cards, sticky cart bar container", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.900}" } } },
      "overlay": { "$value": "{primitive.color.neutral.0}",   "$description": "Bottom sheets, dialogs, menus", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.800}" } } },
      "sunken":  { "$value": "{primitive.color.neutral.100}", "$description": "Input fills, grouped section background", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.1000}" } } },
      "inverse": { "$value": "{primitive.color.neutral.900}", "$description": "Snackbar, tooltip", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.50}" } } }
    },
    "text": {
      "primary":   { "$value": "{primitive.color.neutral.900}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.50}" } } },
      "secondary": { "$value": "{primitive.color.neutral.700}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.300}" } } },
      "tertiary":  { "$value": "{primitive.color.neutral.600}", "$description": "Placeholders, helper text, unit size", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.400}" } } },
      "disabled":  { "$value": "{primitive.color.neutral.400}", "$description": "WCAG 1.4.3 exempt (inactive UI). Never used for information.", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.600}" } } },
      "inverse":   { "$value": "{primitive.color.neutral.0}",   "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.950}" } } },
      "link":      { "$value": "{primitive.color.brand.600}",   "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brand.200}" } } }
    },
    "border": {
      "subtle":  { "$value": "{primitive.color.neutral.200}", "$description": "Dividers (decorative)", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.800}" } } },
      "default": { "$value": "{primitive.color.neutral.300}", "$description": "Card outlines (decorative)", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.700}" } } },
      "strong":  { "$value": "{primitive.color.neutral.500}", "$description": "Input and control boundaries (>= 3:1)", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.500}" } } },
      "focus":   { "$value": "{primitive.color.brand.600}",   "$description": "Focus ring (>= 3:1)", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brand.300}" } } }
    },
    "brand": {
      "primary":            { "$value": "{primitive.color.brand.600}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brand.300}" } } },
      "primaryHover":       { "$value": "{primitive.color.brand.700}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brand.200}" } } },
      "primaryPressed":     { "$value": "{primitive.color.brand.800}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brand.100}" } } },
      "onPrimary":          { "$value": "{primitive.color.neutral.0}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brand.950}" } } },
      "primaryContainer":   { "$value": "{primitive.color.brand.50}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brand.900}" } } },
      "onPrimaryContainer": { "$value": "{primitive.color.brand.800}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brand.100}" } } },
      "secondary":          { "$value": "{primitive.color.brandSecondary.600}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brandSecondary.200}" } } },
      "onSecondary":        { "$value": "{primitive.color.neutral.0}",          "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brandSecondary.900}" } } },
      "accent":             { "$value": "{primitive.color.brandAccent.600}",    "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brandAccent.300}" } } },
      "onAccent":           { "$value": "{primitive.color.neutral.0}",          "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brandAccent.900}" } } }
    },
    "feedback": {
      "success": {
        "fg":          { "$value": "{primitive.color.green.700}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.green.300}" } } },
        "fill":        { "$value": "{primitive.color.green.600}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.green.300}" } } },
        "onFill":      { "$value": "{primitive.color.neutral.0}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.green.900}" } } },
        "container":   { "$value": "{primitive.color.green.50}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.green.900}" } } },
        "onContainer": { "$value": "{primitive.color.green.800}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.green.100}" } } }
      },
      "warning": {
        "fg":          { "$value": "{primitive.color.amber.700}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.amber.300}" } } },
        "fill":        { "$value": "{primitive.color.amber.400}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.amber.300}" } } },
        "onFill":      { "$value": "{primitive.color.neutral.950}","$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.amber.900}" } } },
        "container":   { "$value": "{primitive.color.amber.50}",   "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.amber.900}" } } },
        "onContainer": { "$value": "{primitive.color.amber.800}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.amber.100}" } } }
      },
      "danger": {
        "fg":          { "$value": "{primitive.color.red.600}",   "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.red.200}" } } },
        "fill":        { "$value": "{primitive.color.red.600}",   "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.red.300}" } } },
        "onFill":      { "$value": "{primitive.color.neutral.0}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.red.900}" } } },
        "container":   { "$value": "{primitive.color.red.50}",    "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.red.900}" } } },
        "onContainer": { "$value": "{primitive.color.red.800}",   "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.red.100}" } } }
      },
      "info": {
        "fg":          { "$value": "{primitive.color.blue.600}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.blue.200}" } } },
        "fill":        { "$value": "{primitive.color.blue.600}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.blue.300}" } } },
        "onFill":      { "$value": "{primitive.color.neutral.0}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.blue.900}" } } },
        "container":   { "$value": "{primitive.color.blue.50}",   "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.blue.900}" } } },
        "onContainer": { "$value": "{primitive.color.blue.800}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.blue.100}" } } }
      }
    },
    "commerce": {
      "price": {
        "current": { "$value": "{primitive.color.neutral.900}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.50}" } } },
        "mrp":     { "$value": "{primitive.color.neutral.600}", "$description": "Struck-through list price; still >= 4.5:1", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.400}" } } },
        "perUnit": { "$value": "{primitive.color.neutral.600}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.400}" } } },
        "saving":  { "$value": "{primitive.color.green.700}",   "$description": "Inline 'You save X' text", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.green.300}" } } }
      },
      "discount": {
        "fill":   { "$value": "{primitive.color.blue.600}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.blue.200}" } } },
        "onFill": { "$value": "{primitive.color.neutral.0}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.blue.900}" } } }
      },
      "offer": {
        "fill":        { "$value": "{primitive.color.violet.600}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.violet.200}" } } },
        "onFill":      { "$value": "{primitive.color.neutral.0}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.violet.900}" } } },
        "container":   { "$value": "{primitive.color.violet.50}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.violet.900}" } } },
        "onContainer": { "$value": "{primitive.color.violet.700}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.violet.100}" } } }
      },
      "badge": {
        "newFill":            { "$value": "{primitive.color.brand.50}",   "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brand.900}" } } },
        "onNewFill":          { "$value": "{primitive.color.brand.800}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brand.100}" } } },
        "bestsellerFill":     { "$value": "{primitive.color.amber.100}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.amber.800}" } } },
        "onBestsellerFill":   { "$value": "{primitive.color.amber.900}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.amber.50}" } } },
        "limitedStockFill":   { "$value": "{primitive.color.red.50}",     "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.red.900}" } } },
        "onLimitedStockFill": { "$value": "{primitive.color.red.700}",    "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.red.100}" } } },
        "outOfStockFill":     { "$value": "{primitive.color.neutral.700}","$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.200}" } } },
        "onOutOfStockFill":   { "$value": "{primitive.color.neutral.0}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.950}" } } }
      },
      "rating": {
        "fill":   { "$value": "{primitive.color.green.700}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.green.300}" } } },
        "onFill": { "$value": "{primitive.color.neutral.0}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.green.900}" } } },
        "star":   { "$value": "{primitive.color.amber.600}", "$description": "Graphic, >= 3:1 on surface", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.amber.400}" } } }
      }
    },
    "dietary": {
      "$description": "Marker colors; which markers show is configured per country/tenant (see 03-CONFIG-FLAGS-TAX.md). Always paired with a shape and an accessible label.",
      "veg":    { "$value": "{primitive.color.green.600}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.green.400}" } } },
      "nonVeg": { "$value": "{primitive.color.red.600}",   "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.red.400}" } } },
      "egg":    { "$value": "{primitive.color.amber.600}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.amber.400}" } } },
      "other":  { "$value": "{primitive.color.neutral.600}", "$description": "Halal, vegan, gluten-free etc. use icon + label in this neutral", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.400}" } } }
    },
    "overlay": {
      "scrim":   { "$value": "{primitive.color.alpha.scrimLight}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.alpha.scrimDark}" } } },
      "pressed": { "$value": "{primitive.color.alpha.pressLight}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.alpha.pressDark}" } } }
    },
    "skeleton": {
      "base":      { "$value": "{primitive.color.neutral.100}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.900}" } } },
      "highlight": { "$value": "{primitive.color.neutral.50}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.800}" } } }
    },
    "map": {
      "route":       { "$value": "{primitive.color.brand.600}",  "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brand.300}" } } },
      "riderMarker": { "$value": "{primitive.color.brandAccent.600}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.brandAccent.300}" } } },
      "destination": { "$value": "{primitive.color.neutral.900}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.neutral.50}" } } }
    },
    "sla": {
      "$description": "Store/rider timers: on track, at risk, breached. Always paired with text and icon.",
      "onTrack":  { "$value": "{primitive.color.green.700}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.green.300}" } } },
      "atRisk":   { "$value": "{primitive.color.amber.700}", "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.amber.300}" } } },
      "breached": { "$value": "{primitive.color.red.600}",   "$extensions": { "com.quickcart.modes": { "dark": "{primitive.color.red.200}" } } }
    }
  },

  "typography": {
    "$type": "typography",
    "$description": "Latin metrics. Arabic: lineHeight x 1.15 (min 1.5 for body). Devanagari: lineHeight x 1.2 (min 1.6 for body). Never apply letterSpacing to Arabic (cursive joins). Applied by the theme builder per script.",
    "displayLg":  { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.40}", "fontWeight": "{primitive.font.weight.bold}",     "lineHeight": 1.2,  "letterSpacing": "-0.5px" } },
    "displayMd":  { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.32}", "fontWeight": "{primitive.font.weight.bold}",     "lineHeight": 1.25, "letterSpacing": "-0.25px" } },
    "headlineLg": { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.28}", "fontWeight": "{primitive.font.weight.bold}",     "lineHeight": 1.29, "letterSpacing": "0px" } },
    "headlineMd": { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.24}", "fontWeight": "{primitive.font.weight.semibold}", "lineHeight": 1.33, "letterSpacing": "0px" } },
    "titleLg":    { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.20}", "fontWeight": "{primitive.font.weight.semibold}", "lineHeight": 1.4,  "letterSpacing": "0px" } },
    "titleMd":    { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.18}", "fontWeight": "{primitive.font.weight.semibold}", "lineHeight": 1.33, "letterSpacing": "0px" } },
    "titleSm":    { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.16}", "fontWeight": "{primitive.font.weight.semibold}", "lineHeight": 1.375,"letterSpacing": "0px" } },
    "bodyLg":     { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.16}", "fontWeight": "{primitive.font.weight.regular}",  "lineHeight": 1.5,  "letterSpacing": "0px" } },
    "bodyMd":     { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.14}", "fontWeight": "{primitive.font.weight.regular}",  "lineHeight": 1.43, "letterSpacing": "0px" } },
    "bodySm":     { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.13}", "fontWeight": "{primitive.font.weight.regular}",  "lineHeight": 1.38, "letterSpacing": "0px" } },
    "labelLg":    { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.16}", "fontWeight": "{primitive.font.weight.semibold}", "lineHeight": 1.25, "letterSpacing": "0.1px" } },
    "labelMd":    { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.14}", "fontWeight": "{primitive.font.weight.semibold}", "lineHeight": 1.29, "letterSpacing": "0.1px" } },
    "labelSm":    { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.12}", "fontWeight": "{primitive.font.weight.semibold}", "lineHeight": 1.33, "letterSpacing": "0.2px" } },
    "caption":    { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.12}", "fontWeight": "{primitive.font.weight.regular}",  "lineHeight": 1.33, "letterSpacing": "0.2px" } },
    "badge":      { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.11}", "fontWeight": "{primitive.font.weight.bold}",     "lineHeight": 1.45, "letterSpacing": "0.3px" } },
    "priceLg":    { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.20}", "fontWeight": "{primitive.font.weight.bold}",     "lineHeight": 1.2,  "letterSpacing": "0px" }, "$description": "Tabular figures (font-feature-settings 'tnum')" },
    "priceMd":    { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.16}", "fontWeight": "{primitive.font.weight.bold}",     "lineHeight": 1.25, "letterSpacing": "0px" }, "$description": "Tabular figures" },
    "priceSm":    { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.14}", "fontWeight": "{primitive.font.weight.bold}",     "lineHeight": 1.29, "letterSpacing": "0px" }, "$description": "Tabular figures" },
    "mrp":        { "$value": { "fontFamily": "{primitive.font.family.brand}", "fontSize": "{primitive.font.size.12}", "fontWeight": "{primitive.font.weight.regular}",  "lineHeight": 1.33, "letterSpacing": "0px" }, "$description": "Struck through, tabular figures" }
  },

  "space": {
    "$type": "dimension",
    "$description": "4-pt scale. Names are multiples of 4px (space.4 = 16px).",
    "0":    { "$value": "0px" },
    "0_5":  { "$value": "2px" },
    "1":    { "$value": "4px" },
    "2":    { "$value": "8px" },
    "3":    { "$value": "12px" },
    "4":    { "$value": "16px" },
    "5":    { "$value": "20px" },
    "6":    { "$value": "24px" },
    "8":    { "$value": "32px" },
    "10":   { "$value": "40px" },
    "12":   { "$value": "48px" },
    "16":   { "$value": "64px" },
    "20":   { "$value": "80px" },
    "gutter":      { "$value": "{space.4}", "$description": "Screen side padding on phones" },
    "gutterTablet":{ "$value": "{space.6}" },
    "gridGap":     { "$value": "{space.2}", "$description": "Product grid gap" },
    "cardInset":   { "$value": "{space.2}" },
    "sectionGap":  { "$value": "{space.6}" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "Base values at scaleFactor 1.0. Tenant scaleFactor (0, 0.5, 1, 1.5) multiplies every value except full.",
    "scaleFactor": { "$type": "number", "$value": 1 },
    "none": { "$value": "0px" },
    "xs":   { "$value": "4px" },
    "sm":   { "$value": "8px" },
    "md":   { "$value": "12px" },
    "lg":   { "$value": "16px" },
    "xl":   { "$value": "24px" },
    "full": { "$value": "9999px" }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "$value is light mode. Dark mode uses stronger, tighter shadows plus a lighter surface tone (color.surface.raised/overlay).",
    "0": { "$value": { "color": "#00000000", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" } },
    "1": {
      "$value": { "color": "{primitive.color.alpha.shadowLight}", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" },
      "$extensions": { "com.quickcart.modes": { "dark": { "color": "{primitive.color.alpha.shadowDark}", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } } }
    },
    "2": {
      "$value": { "color": "{primitive.color.alpha.shadowLight}", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "-2px" },
      "$extensions": { "com.quickcart.modes": { "dark": { "color": "{primitive.color.alpha.shadowDark}", "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "0px" } } }
    },
    "3": {
      "$value": { "color": "{primitive.color.alpha.shadowLightStrong}", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-4px" },
      "$extensions": { "com.quickcart.modes": { "dark": { "color": "{primitive.color.alpha.shadowDarkStrong}", "offsetX": "0px", "offsetY": "6px", "blur": "16px", "spread": "0px" } } }
    },
    "4": {
      "$value": { "color": "{primitive.color.alpha.shadowLightStrong}", "offsetX": "0px", "offsetY": "16px", "blur": "40px", "spread": "-8px" },
      "$extensions": { "com.quickcart.modes": { "dark": { "color": "{primitive.color.alpha.shadowDarkStrong}", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" } } }
    }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "instant":  { "$value": "{primitive.duration.0}" },
      "micro":    { "$value": "{primitive.duration.100}", "$description": "Press feedback, count bump" },
      "short":    { "$value": "{primitive.duration.150}", "$description": "Button to stepper morph, chip select" },
      "medium":   { "$value": "{primitive.duration.250}", "$description": "Cart bar slide-in, toast" },
      "long":     { "$value": "{primitive.duration.300}", "$description": "Bottom sheet, page transition" },
      "xlong":    { "$value": "{primitive.duration.500}", "$description": "Success checkmark draw, fly-to-cart" },
      "shimmer":  { "$value": "{primitive.duration.1200}", "$description": "One skeleton shimmer sweep" },
      "mapTick":  { "$value": "{primitive.duration.1500}", "$description": "Rider marker interpolation window (shorter than ping interval)" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard":   { "$value": "{primitive.easing.standard}" },
      "enter":      { "$value": "{primitive.easing.decelerate}" },
      "exit":       { "$value": "{primitive.easing.accelerate}" },
      "emphasized": { "$value": "{primitive.easing.emphasized}" },
      "linear":     { "$value": "{primitive.easing.linear}" }
    }
  },

  "zIndex": {
    "$type": "number",
    "base":       { "$value": 0 },
    "raised":     { "$value": 10 },
    "sticky":     { "$value": 100 },
    "cartBar":    { "$value": 200 },
    "dropdown":   { "$value": 300 },
    "overlay":    { "$value": 400 },
    "sheet":      { "$value": 500 },
    "dialog":     { "$value": 600 },
    "toast":      { "$value": 700 },
    "tooltip":    { "$value": 800 },
    "debug":      { "$value": 9000 }
  },

  "breakpoint": {
    "$type": "dimension",
    "xs":  { "$value": "0px",    "$description": "Phones (compact)" },
    "sm":  { "$value": "360px",  "$description": "Standard phones" },
    "md":  { "$value": "600px",  "$description": "Large phones landscape, small tablets, unfolded foldables" },
    "lg":  { "$value": "840px",  "$description": "Tablets (store app two-pane)" },
    "xl":  { "$value": "1200px", "$description": "Desktop dashboards" },
    "xxl": { "$value": "1600px", "$description": "Wide dashboards" }
  },

  "size": {
    "$type": "dimension",
    "touchTarget":    { "$value": "48px", "$description": "Minimum hit area, both axes" },
    "touchTargetDense": { "$value": "40px", "$description": "Admin web pointer UIs only, with 8px spacing" },
    "icon": {
      "xs": { "$value": "12px" },
      "sm": { "$value": "16px" },
      "md": { "$value": "20px" },
      "lg": { "$value": "24px" },
      "xl": { "$value": "32px" },
      "xxl": { "$value": "48px" }
    },
    "appBar":     { "$value": "56px" },
    "cartBar":    { "$value": "64px" },
    "bottomNav":  { "$value": "64px" },
    "stepperHeight": { "$value": "36px", "$description": "Visual height; hit area padded to touchTarget" },
    "productImageGrid": { "$value": "120px" },
    "productImageList": { "$value": "88px" },
    "focusRing":  { "$value": "2px" },
    "focusOffset":{ "$value": "2px" }
  },

  "opacity": {
    "$type": "number",
    "disabled":   { "$value": 0.38 },
    "outOfStockImage": { "$value": 0.45 },
    "hover":      { "$value": 0.08 },
    "pressed":    { "$value": 0.12 },
    "dragged":    { "$value": 0.16 },
    "scrim":      { "$value": 0.56 }
  },

  "component": {
    "$description": "Tier 3: component tokens. Reference semantic tokens only.",
    "button": {
      "primary": {
        "background":   { "$type": "color", "$value": "{color.brand.primary}" },
        "foreground":   { "$type": "color", "$value": "{color.brand.onPrimary}" },
        "backgroundPressed": { "$type": "color", "$value": "{color.brand.primaryPressed}" }
      },
      "height":  { "$type": "dimension", "$value": "{size.touchTarget}" },
      "radius":  { "$type": "dimension", "$value": "{radius.sm}" },
      "paddingX":{ "$type": "dimension", "$value": "{space.4}" },
      "typography": { "$type": "typography", "$value": "{typography.labelLg}" }
    },
    "addButton": {
      "background": { "$type": "color", "$value": "{color.surface.base}" },
      "foreground": { "$type": "color", "$value": "{color.brand.primary}" },
      "border":     { "$type": "color", "$value": "{color.brand.primary}" },
      "radius":     { "$type": "dimension", "$value": "{radius.sm}" },
      "minWidth":   { "$type": "dimension", "$value": "72px" }
    },
    "stepper": {
      "background": { "$type": "color", "$value": "{color.brand.primary}" },
      "foreground": { "$type": "color", "$value": "{color.brand.onPrimary}" },
      "height":     { "$type": "dimension", "$value": "{size.stepperHeight}" },
      "radius":     { "$type": "dimension", "$value": "{radius.sm}" },
      "morphDuration": { "$type": "duration", "$value": "{motion.duration.short}" }
    },
    "productCard": {
      "background": { "$type": "color", "$value": "{color.surface.base}" },
      "border":     { "$type": "color", "$value": "{color.border.subtle}" },
      "radius":     { "$type": "dimension", "$value": "{radius.md}" },
      "padding":    { "$type": "dimension", "$value": "{space.cardInset}" },
      "titleTypography": { "$type": "typography", "$value": "{typography.bodyMd}" },
      "priceTypography": { "$type": "typography", "$value": "{typography.priceMd}" }
    },
    "badge": {
      "radius":     { "$type": "dimension", "$value": "{radius.xs}" },
      "paddingX":   { "$type": "dimension", "$value": "{space.1}" },
      "height":     { "$type": "dimension", "$value": "20px" },
      "typography": { "$type": "typography", "$value": "{typography.badge}" }
    },
    "cartBar": {
      "background": { "$type": "color", "$value": "{color.brand.primary}" },
      "foreground": { "$type": "color", "$value": "{color.brand.onPrimary}" },
      "height":     { "$type": "dimension", "$value": "{size.cartBar}" },
      "radius":     { "$type": "dimension", "$value": "{radius.md}" },
      "shadow":     { "$type": "shadow", "$value": "{shadow.3}" },
      "enterDuration": { "$type": "duration", "$value": "{motion.duration.medium}" }
    },
    "bottomSheet": {
      "background": { "$type": "color", "$value": "{color.surface.overlay}" },
      "radius":     { "$type": "dimension", "$value": "{radius.xl}" },
      "scrim":      { "$type": "color", "$value": "{color.overlay.scrim}" },
      "shadow":     { "$type": "shadow", "$value": "{shadow.4}" }
    },
    "input": {
      "background": { "$type": "color", "$value": "{color.surface.sunken}" },
      "border":     { "$type": "color", "$value": "{color.border.strong}" },
      "borderFocus":{ "$type": "color", "$value": "{color.border.focus}" },
      "height":     { "$type": "dimension", "$value": "{size.touchTarget}" },
      "radius":     { "$type": "dimension", "$value": "{radius.sm}" }
    },
    "chip": {
      "background":         { "$type": "color", "$value": "{color.surface.base}" },
      "border":             { "$type": "color", "$value": "{color.border.strong}" },
      "selectedBackground": { "$type": "color", "$value": "{color.brand.primaryContainer}" },
      "selectedForeground": { "$type": "color", "$value": "{color.brand.onPrimaryContainer}" },
      "height":             { "$type": "dimension", "$value": "32px" },
      "radius":             { "$type": "dimension", "$value": "{radius.full}" }
    },
    "skeleton": {
      "base":      { "$type": "color", "$value": "{color.skeleton.base}" },
      "highlight": { "$type": "color", "$value": "{color.skeleton.highlight}" },
      "radius":    { "$type": "dimension", "$value": "{radius.xs}" },
      "duration":  { "$type": "duration", "$value": "{motion.duration.shimmer}" }
    },
    "toast": {
      "background": { "$type": "color", "$value": "{color.surface.inverse}" },
      "foreground": { "$type": "color", "$value": "{color.text.inverse}" },
      "radius":     { "$type": "dimension", "$value": "{radius.sm}" }
    }
  }
}
