# =================================================================================================
# QuickCart production environment (blueprint)
#
# Copy to infra/docker/.env and edit. Values shown are EXAMPLES or defaults, not recommendations for
# your hardware. Every application variable is validated at startup by packages/config/src/env.schema.ts;
# the process prints every problem at once and exits with status 78 if anything is wrong.
#
# Secrets are NEVER put in this file. They live in ./secrets/<name> (one value per file, no quotes),
# are mounted at /run/secrets/<name>, and are read through the *_FILE variables set in compose.yaml.
# The list of secret files is at the bottom of this file.
# =================================================================================================

# -------------------------------------------------------------------------------------------------
# Compose: release, profiles, scaling
# -------------------------------------------------------------------------------------------------
# Image registry and release tag (semver). Required. Never use a moving tag such as "latest".
QC_REGISTRY=ghcr.io/example/quickcart
QC_VERSION=1.0.0

# Enabled profiles, comma-separated:
#   bundled-db     run PostgreSQL in this stack (remove for an external/managed database)
#   local-storage  run MinIO (remove when using AWS S3, Cloudflare R2 or another S3 service)
#   backup         pgBackRest + pg_dump + Meilisearch dumps + offsite copy
#   observability  Prometheus, Grafana, Loki, Promtail
COMPOSE_PROFILES=bundled-db,local-storage

# API and worker replica counts and limits. Socket.IO uses websocket-only transport, so API replicas
# need no sticky sessions.
API_REPLICAS=2
API_CPUS=1.0
API_MEMORY=768M
WORKER_REPLICAS=1
WORKER_CPUS=1.0
WORKER_MEMORY=1G

# -------------------------------------------------------------------------------------------------
# Edge (Caddy)
# -------------------------------------------------------------------------------------------------
# Host name of the platform (super admin, installer, API). Use "localhost" for a local trial; Caddy then
# issues a certificate from its internal CA.
PLATFORM_HOST=platform.example.com
# Contact e-mail for the ACME account (Let's Encrypt expiry notices).
ACME_EMAIL=ops@example.com
# ACME directory. Use the Let's Encrypt staging URL while testing to avoid rate limits:
# https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# -------------------------------------------------------------------------------------------------
# Application: runtime
# -------------------------------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Public origin of the platform host. Must be https:// in production, no path. Must equal
# https://${PLATFORM_HOST} or be under PLATFORM_ROOT_DOMAIN.
PUBLIC_BASE_URL=https://platform.example.com
# Root domain for tenant subdomains: {tenantSlug}.${PLATFORM_ROOT_DOMAIN}.
PLATFORM_ROOT_DOMAIN=example.com
# Proxies whose X-Forwarded-* headers are trusted (proxy-addr syntax). Caddy runs on a private network.
TRUST_PROXY=loopback,uniquelocal
# Extra browser origins allowed to call the API (comma-separated, https:// in production). Tenant hosts
# and custom domains are allowed automatically; list only third-party origins here.
CORS_ALLOWED_ORIGINS=

# -------------------------------------------------------------------------------------------------
# Application: PostgreSQL (connection strings are secrets, see bottom)
# -------------------------------------------------------------------------------------------------
# Client connections per api/worker process to PgBouncer.
DATABASE_POOL_MAX=10
# Per-statement timeout for request traffic (ms). Reports use the read replica with a higher timeout.
DATABASE_STATEMENT_TIMEOUT_MS=5000
# disable | require | verify-full. Use require or verify-full for managed databases (then also set
# DATABASE_SSL_CA_FILE in compose.yaml for verify-full).
DATABASE_SSL_MODE=disable

# Bundled PostgreSQL (profile bundled-db)
POSTGRES_DB=quickcart
# Schema owner role. Used only by migrations and the installer; the API runs as app_user / app_platform.
POSTGRES_OWNER=quickcart_owner
# Override with the derived image (postgis + pgbackrest) when the backup profile is enabled.
PG_IMAGE=postgis/postgis:16-3.4
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_CPUS=2.0
PG_MEMORY=4G
# WAL archiving command. /bin/true disables archiving. With the backup profile:
# PG_ARCHIVE_COMMAND=pgbackrest --stanza=quickcart archive-push %p
PG_ARCHIVE_COMMAND=/bin/true

# -------------------------------------------------------------------------------------------------
# Application: Redis
# -------------------------------------------------------------------------------------------------
# Prefix for every key (lets several environments share one Redis).
REDIS_KEY_PREFIX=qc:
# Durable instance (queues, locks, Socket.IO adapter). Eviction is disabled; size for peak queue depth.
REDIS_MAXMEMORY=768mb
REDIS_MEMORY=1G
# Cache instance (LRU eviction, no persistence).
REDIS_CACHE_MAXMEMORY=512mb
REDIS_CACHE_MEMORY=640M

# -------------------------------------------------------------------------------------------------
# Application: Meilisearch
# -------------------------------------------------------------------------------------------------
# Optional prefix for index names: <prefix>products_<tenantSlug>_<locale>.
MEILI_INDEX_PREFIX=
MEILI_MAX_INDEXING_MEMORY=1GiB
MEILI_MAX_INDEXING_THREADS=2
MEILI_CPUS=2.0
MEILI_MEMORY=2G
# Search sync: wait this long after the last change before flushing an index batch (ms).
SEARCH_SYNC_DEBOUNCE_MS=2000
# Maximum documents per Meilisearch update request.
SEARCH_SYNC_BATCH_SIZE=1000

# -------------------------------------------------------------------------------------------------
# Application: object storage (S3-compatible)
# -------------------------------------------------------------------------------------------------
# MinIO (local-storage profile): http://minio:9000 with path-style. AWS S3: leave S3_ENDPOINT empty and
# set S3_FORCE_PATH_STYLE=false. Cloudflare R2: https://<account>.r2.cloudflarestorage.com, region "auto".
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=quickcart
S3_FORCE_PATH_STYLE=true
# Public (CDN) base URL for product images and branding. Empty = signed URLs from the API.
S3_PUBLIC_BASE_URL=
# MinIO images (local-storage profile). Mirror into your registry and pin by digest.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2024-10-13T13-34-11Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2024-10-08T09-37-26Z

# -------------------------------------------------------------------------------------------------
# Installer and licensing
# -------------------------------------------------------------------------------------------------
# Lifetime of the one-time setup token (minutes). The token itself is ./secrets/install_token
# (leave that file empty to have the API generate one and print it to its log).
INSTALL_TOKEN_TTL_MINUTES=120
# License server used for online purchase-code verification (example URL).
LICENSE_SERVER_URL=https://license.quickcart.example/api/v1

# -------------------------------------------------------------------------------------------------
# Worker
# -------------------------------------------------------------------------------------------------
WORKER_CONCURRENCY=10
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=500

# -------------------------------------------------------------------------------------------------
# Observability and integrations
# -------------------------------------------------------------------------------------------------
# OTLP/HTTP endpoint for OpenTelemetry traces (empty = tracing disabled).
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_RETENTION=15d
# Sender for platform e-mail (super admin password reset). Requires ./secrets/smtp_url.
MAIL_FROM=
# Self-hosted OSRM for ETAs and route optimization (empty = use the provider configured per tenant).
OSRM_URL=

# -------------------------------------------------------------------------------------------------
# Backup (profile backup)
# -------------------------------------------------------------------------------------------------
# Offsite S3-compatible endpoint for backups. Use a different account/provider from primary storage.
BACKUP_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
BACKUP_S3_BUCKET=quickcart-backups
BACKUP_S3_REGION=eu-central-1
# Cron schedules (UTC). Full weekly, differential daily, logical dump daily, Meilisearch dump daily.
BACKUP_SCHEDULE_FULL=15 2 * * 0
BACKUP_SCHEDULE_DIFF=15 2 * * 1-6
BACKUP_SCHEDULE_LOGICAL=45 3 * * *
BACKUP_SCHEDULE_MEILI=30 4 * * *
# Number of full pgBackRest backups kept (with their WAL) and days of logical dumps kept.
BACKUP_RETENTION_FULL=4
BACKUP_RETENTION_LOGICAL_DAYS=14

# =================================================================================================
# Secret files (./secrets/<name>), mounted at /run/secrets/<name>. One value per file, no trailing
# spaces; a single trailing newline is ignored. chmod 0440, owned by root:10001.
# `quickcart secrets init` (tools/) generates all random values; you supply the external ones.
#
#   postgres_password            Password of POSTGRES_OWNER (bundled-db).          openssl rand -base64 36
#   database_migration_url       postgres://quickcart_owner:<pw>@pgbouncer:6432/quickcart_admin
#   database_url                 postgres://app_user:<pw>@pgbouncer:6432/quickcart
#   database_platform_url        postgres://app_platform:<pw>@pgbouncer:6432/quickcart
#                                (the migrate job creates/updates app_user and app_platform with
#                                 these passwords, so these URLs are the single source of truth)
#   pgbouncer_userlist.txt       "quickcart_owner" "<pw>" / "app_user" "<pw>" / "app_platform" "<pw>"
#                                / "pgbouncer_stats" "<pw>" (one quoted pair per line; SCRAM secrets allowed)
#   redis_users.acl              user default off
#                                user app on ><pw> ~* &* +@all
#                                user healthcheck on nopass -@all +ping
#   redis_url                    redis://app:<pw>@redis:6379/0
#   redis_cache_url              redis://app:<pw>@redis-cache:6379/0
#   meili_master_key             >= 32 characters.                                 openssl rand -base64 48
#   s3_access_key_id             Application access key (MinIO: created by minio-init).
#   s3_secret_access_key         Application secret key (>= 32 chars for MinIO).  openssl rand -base64 36
#   minio_root_user              MinIO root user (local-storage).
#   minio_root_password          MinIO root password (local-storage).            openssl rand -base64 36
#   jwt_secret                   >= 32 characters.                                 openssl rand -base64 48
#   cookie_secret                >= 32 characters, different from jwt_secret.      openssl rand -base64 48
#   data_encryption_key          Exactly 32 bytes, base64 (tenant_secrets AES-256-GCM key).
#                                                                                  openssl rand -base64 32
#   smtp_url                     smtps://user:pass@smtp.example.com:465 (may be empty)
#   install_token                Empty (auto-generate) or 32 random bytes base64url (43 chars).
#                                Remove from compose.yaml after installation is locked.
#   backup_pgpass                *:*:*:quickcart_owner:<pw>  (pgpass format; matches the Unix socket; backup profile)
#   backup_s3_access_key_id      Offsite backup credentials (write-only policy recommended).
#   backup_s3_secret_access_key
#   backup_encryption_key        pgBackRest repository cipher pass (>= 32 chars).  openssl rand -base64 48
#   grafana_admin_password       Grafana admin password (observability).         openssl rand -base64 24
# =================================================================================================
